# Database — leave unset for SQLite (auto-computed absolute path)
# Only set this if using Postgres: DATABASE_URL=postgresql://user:pass@localhost/signals

# Claude API (for LLM classification in ingestion)
ANTHROPIC_API_KEY=your-key-here

# Optional: NewsAPI (free tier, 100 req/day)
NEWS_API_KEY=

# App settings
APP_ENV=development
